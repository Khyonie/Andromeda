#cloud-config
hostname: {vm} 
manage_etc_hosts: true
package_update: true
packages:
  - openssh
  - sudo
  - qemu-guest-agent
  - fish
  - micro
users:
  - name: {user_name}
    shell: /usr/bin/fish
    lock_passwd: true
    ssh_authorized_keys:
      - {user_key}
{sysadmin_user}
ssh_pwauth: false
disable_root: true
write_files:
  - path: /etc/sudoers.d/10-wheel
    permissions: "0440"
    owner: root:root
    content: |
      %wheel ALL=(ALL:ALL) ALL
runcmd:
  - systemctl enable --now sshd
  - systemctl enable --now qemu-guest-agent
# Resize disk on first boot
growpart:
  mode: auto
  devices:
    - /

resize_rootfs: true
