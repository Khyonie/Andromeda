# Rust backend environment (not loaded automatically).
# This must match the browser origin, including the development port.
ANDROMEDA_PUBLIC_ORIGIN=http://localhost:5173
# For HTTP development on a private LAN IP, opt in and update the origin above.
# Also register the matching /api/auth/discord/callback URL in Discord.
ANDROMEDA_ALLOW_INSECURE_HTTP=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Register this exact redirect URI in the Discord Developer Portal:
# http://localhost:5173/api/auth/discord/callback

# Initial gateway when creating the settings record; edit saved values in Administration.
ANDROMEDA_GATEWAY_IP=10.0.0.1

# Comma-separated Discord user IDs allowed to manage system settings.
# Empty disables admin access. Changes to this allowlist require restarting the backend.
ANDROMEDA_ADMIN_DISCORD_IDS=
